{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": false
  },
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": ["./src/**/*"],
  "exclude": ["./src/test/**/*"]
}
